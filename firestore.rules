rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Seat counter: anyone can read (landing page), signed-in users may only increment by exactly 1
    match /meta/stats {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userCount == 1;
      allow update: if request.auth != null && request.resource.data.userCount == resource.data.userCount + 1;
    }
  }
}
